{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true
  },
  "permissions": {
    "default": {
      "read": true,
      "write": true,
      "net": true,
      "env": true,
      "run": true
    }
  },
  "lint": {
    "include": ["*.ts", "src/**/*.ts"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["*.ts", "src/**/*.ts"],
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": false
  },
  "tasks": {
    "start": "deno run -P --env-file=.env main.ts",
    "start:ui": "deno run -P --env-file=.env main.ts --ui",
    "start:cli": "deno run -P --env-file=.env main.ts",
    "dev": "deno run --watch -P --env-file=.env main.ts",
    "dev:ui": "deno run --watch -P --env-file=.env main.ts --ui",
    "dev:cli": "deno run --watch -P --env-file=.env main.ts",
    "prepare:dist": "mkdir -p dist",
    "build": "deno task prepare:dist && deno task build:macos && deno task build:windows && deno task build:linux",
    "build:macos": "deno compile --allow-read --allow-write --allow-net --allow-env --allow-run --target x86_64-apple-darwin --output ./dist/transcriber-macos-x64 main.ts",
    "build:macos-arm": "deno compile --allow-read --allow-write --allow-net --allow-env --allow-run --target aarch64-apple-darwin --output ./dist/transcriber-macos-arm64 main.ts",
    "build:windows": "deno compile --allow-read --allow-write --allow-net --allow-env --allow-run --target x86_64-pc-windows-msvc --output ./dist/transcriber-windows.exe main.ts",
    "build:linux": "deno compile --allow-read --allow-write --allow-net --allow-env --allow-run --target x86_64-unknown-linux-gnu --output ./dist/transcriber-linux main.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test -P --env-file=.env"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/fs/ensure-dir": "jsr:@std/fs@1/ensure-dir",
    "@std/fs/ensure-file": "jsr:@std/fs@1/ensure-file",
    "@std/fs/exists": "jsr:@std/fs@1/exists",
    "@std/media-types": "jsr:@std/media-types@1",
    "@std/http/file-server": "jsr:@std/http@1/file-server",
    "@elevenlabs/elevenlabs-js": "npm:@elevenlabs/elevenlabs-js@2.35.0",
    "types": "./src/types/index.ts"
  }
}
