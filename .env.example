# ElevenLabs API Key (recommended)
# Get your API key from https://elevenlabs.io/
ELEVENLABS_API_KEY=your_api_key_here

# Input/Output Directories (optional)
# Absolute or relative paths to use for source audio and transcript output
INPUT_DIR=inputs
OUTPUT_DIR=outputs

# Default language code for transcription (optional, default: en)
# Uses ISO language codes such as en, hy, ru, es
LANGUAGE=hy

# Default chunk duration in seconds for "parts" mode (optional, default: 30)
# Whole-file mode ignores this unless auto-fallback to parts is triggered
CHUNK_DURATION=30

# Optional long-run hint for future async webhook integration
# Current local app keeps deterministic chunked processing enabled even when true
ENABLE_ELEVENLABS_ASYNC_WEBHOOK=false

# Optional glossary boosts for subtitle generation (comma-separated)
# Global terms applied to all languages:
SUBTITLE_KEYTERMS=
# Language-specific terms (example for Armenian STT code hye):
SUBTITLE_KEYTERMS_HYE=
